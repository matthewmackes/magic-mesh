# WL-FUNC-018 — immutable guest profile for the curated App VM path.
#
# This is intentionally separate from the DRM-native Construct host image. The
# guest owns the Wayland compositor, portals, Flatpak runtime, PipeWire, and
# application surface; the host never installs or launches the app.

ARG APP_VM_BASE=quay.io/fedora/fedora-bootc:44
FROM ${APP_VM_BASE}

ARG MCNF_RPM_LANE=repo
ARG MCNF_APP_VM_SOURCE_COMMIT
ARG MCNF_APP_VM_BASE_IMAGE_ID
ARG MCNF_FLATPAK_CATALOG_SIGNER_ID
ARG MCNF_FLATPAK_CATALOG_KEY_SHA256

COPY packaging/app-vm/rpms/ /tmp/mcnf-rpms/
COPY packaging/app-vm/validate-runtime-inputs.sh /tmp/mcnf-app-vm-validate
COPY packaging/app-vm/mcnf-app-vm-launch.sh /tmp/mcnf-app-vm-launch
COPY packaging/app-vm/mcnf-app-vm-runtime-probe.sh /tmp/mcnf-app-vm-runtime-probe
COPY packaging/app-vm/verify-rpm-supply.sh /tmp/mcnf-app-vm-verify-rpm-supply
COPY packaging/app-vm/verify-rpm-build-identity.py /tmp/verify-rpm-build-identity.py
COPY packaging/app-vm/verify-installed-rpm-identity.sh /tmp/verify-installed-rpm-identity.sh
COPY packaging/repo/magic-mesh.repo /etc/yum.repos.d/magic-mesh.repo
COPY packaging/repo/RPM-GPG-KEY-magic-mesh /tmp/RPM-GPG-KEY-magic-mesh

RUN --mount=type=secret,id=mcnf_catalog_trust_receipt,required=true \
    --mount=type=secret,id=mcnf_catalog_verification_key,required=true \
    set -eux; \
    python3 - "${MCNF_APP_VM_SOURCE_COMMIT}" "${MCNF_FLATPAK_CATALOG_SIGNER_ID}" "${MCNF_FLATPAK_CATALOG_KEY_SHA256}" <<'PY'
import hashlib, json, pathlib, sys
revision, signer, expected_digest = sys.argv[1:]
receipt_path = pathlib.Path('/run/secrets/mcnf_catalog_trust_receipt')
key_path = pathlib.Path('/run/secrets/mcnf_catalog_verification_key')
receipt = json.loads(receipt_path.read_bytes())
expected_keys = {'schema_version', 'kind', 'signer_id', 'source_revision', 'verification_key_sha256'}
if not isinstance(receipt, dict) or set(receipt) != expected_keys:
    raise SystemExit('catalog trust receipt has an unexpected field set')
if receipt['schema_version'] != 1 or receipt['kind'] != 'mcnf-flatpak-catalog-trust':
    raise SystemExit('catalog trust receipt identity is invalid')
if receipt['source_revision'] != revision or receipt['signer_id'] != signer:
    raise SystemExit('catalog trust receipt does not match release build arguments')
key = key_path.read_bytes()
if len(key) != 65 or not key.endswith(b'\n') or not all(c in b'0123456789abcdef' for c in key[:-1]):
    raise SystemExit('catalog verification key is not canonical lowercase Ed25519 hex')
digest = hashlib.sha256(key).hexdigest()
if digest != expected_digest or digest != receipt['verification_key_sha256']:
    raise SystemExit('catalog verification key digest does not match release authority')
pathlib.Path('/etc/mackesd').mkdir(mode=0o755, parents=True, exist_ok=True)
pathlib.Path('/usr/share/mcnf/app-vm').mkdir(mode=0o755, parents=True, exist_ok=True)
pathlib.Path('/etc/mackesd/flatpak-catalog-verification.key').write_bytes(key)
pathlib.Path('/usr/share/mcnf/app-vm/catalog-trust-receipt.json').write_bytes(receipt_path.read_bytes())
PY
RUN set -eux; \
    dnf -y install gnupg2; \
    install -d -m 0700 /tmp/mcnf-gnupg; \
    export GNUPGHOME=/tmp/mcnf-gnupg; \
    chmod 0444 /etc/mackesd/flatpak-catalog-verification.key /usr/share/mcnf/app-vm/catalog-trust-receipt.json; \
    printf '%s\n' "${MCNF_APP_VM_BASE_IMAGE_ID}" | grep -Eq '^sha256:[0-9a-fA-F]{64}$' || { \
        echo "FATAL: App VM base image provenance must be a complete sha256 digest" >&2; exit 1; }; \
    printf '%s\n' "${MCNF_APP_VM_SOURCE_COMMIT}" | grep -Eq '^[0-9a-f]{40}$' && \
        [ "${MCNF_APP_VM_SOURCE_COMMIT}" != 0000000000000000000000000000000000000000 ] || { \
        echo "FATAL: App VM source commit must be a non-null 40-character lowercase Git revision" >&2; exit 1; }; \
    case "${MCNF_RPM_LANE}" in local|repo) ;; *) \
        echo "FATAL: App VM RPM lane must be exactly local or repo" >&2; exit 1 ;; esac; \
    install -D -m 0755 /tmp/mcnf-app-vm-validate /usr/local/libexec/mcnf-app-vm-validate; \
    install -D -m 0755 /tmp/mcnf-app-vm-launch /usr/local/libexec/mcnf-app-vm-launch; \
    install -D -m 0755 /tmp/mcnf-app-vm-runtime-probe /usr/local/libexec/mcnf-app-vm-runtime-probe; \
    chmod 0755 /tmp/mcnf-app-vm-verify-rpm-supply /tmp/verify-rpm-build-identity.py \
        /tmp/verify-installed-rpm-identity.sh; \
    install -D -m 0644 /tmp/RPM-GPG-KEY-magic-mesh /etc/pki/rpm-gpg/RPM-GPG-KEY-magic-mesh; \
    sed -i 's#^gpgkey=.*#gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-magic-mesh#' /etc/yum.repos.d/magic-mesh.repo; \
    grep -Fxq 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-magic-mesh' /etc/yum.repos.d/magic-mesh.repo; \
    rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-magic-mesh; \
    if [ "${MCNF_RPM_LANE}" = local ]; then \
        [ "$(find /tmp/mcnf-rpms -mindepth 1 -maxdepth 1 -name '*.rpm' -printf . | wc -c)" -eq 1 ] || { \
            echo "FATAL: local App VM image lane needs exactly one staged RPM" >&2; exit 1; }; \
        /tmp/mcnf-app-vm-verify-rpm-supply \
            --key /etc/pki/rpm-gpg/RPM-GPG-KEY-magic-mesh \
            --source-commit "${MCNF_APP_VM_SOURCE_COMMIT}" \
            --candidate-manifest /tmp/mcnf-rpms/candidate-manifest.json \
            /tmp/mcnf-rpms/magic-mesh-local.rpm; \
        dnf -y --setopt=localpkg_gpgcheck=1 install /tmp/mcnf-rpms/magic-mesh-local.rpm; \
    else \
        if find /tmp/mcnf-rpms -mindepth 1 -maxdepth 1 \
            \( -name '*.rpm' -o -name 'candidate-manifest.json' \) -print -quit | grep -q .; then \
            echo "FATAL: repo App VM image lane contains local candidate inputs" >&2; exit 1; \
        fi; \
        dnf -y install magic-mesh; \
        /tmp/verify-installed-rpm-identity.sh \
            --source-commit "${MCNF_APP_VM_SOURCE_COMMIT}"; \
    fi; \
    dnf -y install \
        dbus-daemon dbus-tools \
        flatpak \
        sway \
        xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk \
        pipewire pipewire-pulseaudio wireplumber \
        mesa-dri-drivers mesa-libEGL mesa-libGL mesa-libgbm \
        libinput libxkbcommon; \
    install -d -m 0755 /usr/share/mcnf/app-vm; \
    printf '%s\n' \
        'profile=wayland-standard' \
        'compositor=sway' \
        'portal_frontend=xdg-desktop-portal' \
        'portal_backend=xdg-desktop-portal-wlr,xdg-desktop-portal-gtk' \
        'audio=pipewire' \
        'flatpak_remote=curated' \
        'network=deny-by-default' \
        > /usr/share/mcnf/app-vm/wayland-standard.profile; \
    printf '%s\n' "${MCNF_APP_VM_SOURCE_COMMIT}" > /usr/share/mcnf/app-vm/source-commit; \
    printf '%s\n' \
        '{"schema_version":1,"profile":"wayland-standard","compositor":"sway",' \
        '"portal_frontend":"xdg-desktop-portal",' \
        '"portal_backends":["xdg-desktop-portal-wlr","xdg-desktop-portal-gtk"],' \
        '"flatpak_remote":"curated","network":"deny-by-default"}' \
        > /usr/share/mcnf/app-vm/image-contract.json; \
    printf '%s\n' \
        'schema_version=1' \
        'profile=wayland-standard-v1' \
        "base_image_id=${MCNF_APP_VM_BASE_IMAGE_ID}" \
        "source_commit=${MCNF_APP_VM_SOURCE_COMMIT}" \
        > /usr/share/mcnf/app-vm/image-provenance; \
    printf '%s\n' \
        'schema_version=1' \
        'profile=wayland-standard-v1' \
        'compositor=sway' \
        'compositor_executable=/usr/bin/sway' \
        'compositor_ownership=guest' \
        'supervisor_unit=mcnf-app-vm-runtime.service' \
        'supervisor_entrypoint=/usr/local/libexec/mcnf-app-vm-launch' \
        'supervisor_ownership=guest' \
        'readiness_topic=state/vdi/app-runtime' \
        'ready_state=connected' \
        'not_ready_states=installing,starting_app,reconnecting,unavailable,failed' \
        'host_fallback=disabled' \
        > /usr/share/mcnf/app-vm/runtime-readiness; \
    rm -rf /tmp/mcnf-rpms /tmp/mcnf-app-vm-validate /tmp/mcnf-app-vm-launch /tmp/mcnf-app-vm-runtime-probe \
        /tmp/mcnf-app-vm-verify-rpm-supply /tmp/verify-rpm-build-identity.py \
        /tmp/verify-installed-rpm-identity.sh /tmp/RPM-GPG-KEY-magic-mesh /tmp/mcnf-gnupg; \
    dnf clean all

# The curated Flatpak remote is deliberately not created here. Its signed
# remote metadata is deployment-owned; the App VM first-boot runtime checks for
# the exact `curated` remote and refuses to install an app when it is absent.

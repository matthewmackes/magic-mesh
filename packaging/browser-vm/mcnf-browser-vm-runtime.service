[Unit]
Description=MCNF guest-owned Chromium Browser VM runtime
Wants=network-online.target seatd.service qemu-guest-agent.service
After=network-online.target systemd-user-sessions.service seatd.service qemu-guest-agent.service
Requires=seatd.service

[Service]
Type=simple
User=mcnf-browser
SupplementaryGroups=video input audio
RuntimeDirectory=mcnf-browser
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/mcnf-browser
Environment=LIBSEAT_BACKEND=seatd
ExecStart=/usr/local/libexec/mcnf-browser-vm-runtime
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

# WL-ARCH-008 — immutable Chromium Browser VM guest image.
# The image owns Chromium, Wayland, GPU/audio/input plumbing, and the runtime.

ARG BROWSER_VM_BASE=quay.io/fedora/fedora-bootc@sha256:effcf2fc509730f77a2e362534afc899ac5a5402a4acb2c30ae0a2f731b00ba4
FROM ${BROWSER_VM_BASE}

ARG MCNF_RPM_LANE=repo
ARG BROWSER_VM_SOURCE_COMMIT
COPY packaging/browser-vm/validate-runtime-inputs.sh /tmp/mcnf-browser-vm-validate
COPY packaging/browser-vm/mcnf-browser-vm-runtime.sh /tmp/mcnf-browser-vm-runtime
COPY packaging/browser-vm/mcnf-browser-vm-runtime.service /tmp/mcnf-browser-vm-runtime.service
COPY packaging/browser-vm/mcnf-browser-vm-xrdp-startwm.sh /tmp/mcnf-browser-vm-xrdp-startwm
COPY packaging/browser-vm/mcnf-browser-vm-session.sh /tmp/mcnf-browser-vm-session
COPY packaging/browser-vm/mcnf-browser-vm-media-fixture.html /tmp/mcnf-browser-vm-media-fixture.html
COPY packaging/browser-vm/mcnf-browser-vm-media-probe.sh /tmp/mcnf-browser-vm-media-probe
COPY crates/desktop/mde-media-core/tests/fixtures/tiny_clip.mkv /tmp/mcnf-browser-vm-tiny_clip.mkv
COPY packaging/browser-vm/rpms/ /tmp/mcnf-rpms/
COPY packaging/repo/magic-mesh.repo /etc/yum.repos.d/magic-mesh.repo

RUN set -eux; \
    install -D -m 0755 /tmp/mcnf-browser-vm-validate /usr/local/libexec/mcnf-browser-vm-validate; \
    install -D -m 0755 /tmp/mcnf-browser-vm-runtime /usr/local/libexec/mcnf-browser-vm-runtime; \
    install -D -m 0644 /tmp/mcnf-browser-vm-runtime.service /etc/systemd/system/mcnf-browser-vm-runtime.service; \
    install -D -m 0755 /tmp/mcnf-browser-vm-xrdp-startwm /etc/xrdp/startwm.sh; \
    install -D -m 0755 /tmp/mcnf-browser-vm-session /usr/local/libexec/mcnf-browser-vm-session; \
    install -D -m 0755 /tmp/mcnf-browser-vm-media-probe /usr/local/libexec/mcnf-browser-vm-media-probe; \
    install -D -m 0644 /tmp/mcnf-browser-vm-media-fixture.html /usr/share/mcnf/browser-vm/mcnf-browser-vm-media-fixture.html; \
    install -D -m 0644 /tmp/mcnf-browser-vm-tiny_clip.mkv /usr/share/mcnf/browser-vm/fixtures/tiny_clip.mkv; \
    if [ "${MCNF_RPM_LANE}" = "local" ]; then \
        guest_rpm="$(find /tmp/mcnf-rpms -maxdepth 1 -type f -name 'magic-mesh-lighthouse-*.rpm' -print -quit)"; \
        [ -n "$guest_rpm" ] || { echo 'FATAL: local Browser VM lane needs a magic-mesh-lighthouse RPM'; exit 1; }; \
        [ "$(rpm -qp --qf '%{NAME}' "$guest_rpm")" = magic-mesh-lighthouse ] || { echo 'FATAL: Browser VM accepts only the thin magic-mesh-lighthouse guest package'; exit 1; }; \
        dnf -y --setopt=install_weak_deps=False install "$guest_rpm"; \
    else dnf -y --setopt=install_weak_deps=False --exclude=magic-mesh-browser install magic-mesh-lighthouse; fi; \
    dnf -y --setopt=install_weak_deps=False \
        --exclude=magic-mesh-browser install \
        chromium cloud-init dbus-daemon dbus-tools seatd sway \
        xdg-desktop-portal xdg-desktop-portal-wlr \
        pipewire pipewire-utils pipewire-pulseaudio wireplumber spice-vdagent \
        pipewire-alsa alsa-lib alsa-ucm alsa-utils \
        pulseaudio-utils \
        mesa-dri-drivers mesa-libEGL mesa-libGL mesa-libgbm \
        libva-utils libinput libxkbcommon xorg-x11-server-Xwayland \
        xrdp xorgxrdp qemu-guest-agent; \
    useradd --create-home --shell /bin/bash mcnf-browser; \
    for group in video input audio seat render; do \
        if ! grep -q "^${group}:" /etc/group; then \
            gid="$(getent group "$group" | awk -F: 'NR == 1 { print $3 }')"; \
            case "$gid" in ''|*[!0-9]*) echo "FATAL: cannot resolve device group $group"; exit 1 ;; esac; \
            grep -q ":${gid}:" /etc/group && { echo "FATAL: device group GID is already allocated: $group=$gid"; exit 1; }; \
            printf '%s:x:%s:\n' "$group" "$gid" >> /etc/group; \
        fi; \
        usermod -a -G "$group" mcnf-browser; \
    done; \
    install -d -o mcnf-browser -g mcnf-browser -m 0700 /var/lib/mcnf-browser; \
    install -d -m 0755 /usr/share/mcnf/browser-vm; \
    printf '%s\n' "$BROWSER_VM_SOURCE_COMMIT" > /usr/share/mcnf/browser-vm/source-commit; \
    printf '%s\n' \
        '{"schema_version":1,"profile":"browser-vm-chromium","browser":"chromium","control_plane":"magic-mesh-lighthouse","compositor":"sway","display":"wayland-over-vdi","gpu":"mesa-virtio","audio":"pipewire","input":"libinput","transports":["rdp","spice"],"guest_agent":"qemu-guest-agent","network":"mesh-guest","host_browser":false}' \
        > /usr/share/mcnf/browser-vm/image-contract.json; \
    systemctl enable qemu-guest-agent.service; \
    # Fedora ships spice-vdagentd as a static unit. Install the target link
    # explicitly so the guest agent starts when the SPICE channel is present.
    ln -sf /usr/lib/systemd/system/spice-vdagentd.service /etc/systemd/system/multi-user.target.wants/spice-vdagentd.service; \
    systemctl enable xrdp.service; \
    rm -rf /tmp/mcnf-rpms /tmp/mcnf-browser-vm-validate /tmp/mcnf-browser-vm-runtime /tmp/mcnf-browser-vm-runtime.service /tmp/mcnf-browser-vm-xrdp-startwm /tmp/mcnf-browser-vm-session /tmp/mcnf-browser-vm-media-fixture.html /tmp/mcnf-browser-vm-media-probe /tmp/mcnf-browser-vm-tiny_clip.mkv; \
    dnf clean all

RUN systemctl enable mcnf-browser-vm-runtime.service
RUN systemctl enable seatd.service

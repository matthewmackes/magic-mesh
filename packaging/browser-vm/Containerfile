# WL-ARCH-008 — immutable Chromium Browser VM guest image.
# The image owns Chromium, Wayland, GPU/audio/input plumbing, and the runtime.

ARG BROWSER_VM_BASE=quay.io/fedora/fedora-bootc@sha256:4d3600c36e461f77af144750fb7c199f8c80f1c987bad492def4215dcf1bbf7f
FROM ${BROWSER_VM_BASE} AS browser-vm-controller-builder

COPY install-helpers/browser-vm-production-control/ /tmp/browser-vm-production-control/
RUN set -eux; \
    dnf -y --setopt=install_weak_deps=False install cargo gcc rust; \
    install -d -m 0700 /tmp/mcnf-builder-home /tmp/mcnf-cargo-home; \
    HOME=/tmp/mcnf-builder-home CARGO_HOME=/tmp/mcnf-cargo-home \
    cargo build --release --locked \
        --manifest-path /tmp/browser-vm-production-control/guest-controller/Cargo.toml \
        --target-dir /tmp/browser-vm-controller-target \
        --bin browser-vm-guest-audio-probe-controller; \
    install -D -m 0755 \
        /tmp/browser-vm-controller-target/release/browser-vm-guest-audio-probe-controller \
        /out/browser-vm-guest-audio-probe-controller

FROM ${BROWSER_VM_BASE}

ARG MCNF_RPM_LANE=repo
ARG BROWSER_VM_SOURCE_COMMIT
COPY packaging/browser-vm/validate-runtime-inputs.sh /tmp/mcnf-browser-vm-validate
COPY packaging/browser-vm/mcnf-browser-vm-runtime.sh /tmp/mcnf-browser-vm-runtime
COPY packaging/browser-vm/mcnf-browser-vm-runtime.service /tmp/mcnf-browser-vm-runtime.service
COPY packaging/browser-vm/mcnf-browser-vm-xrdp-startwm.sh /tmp/mcnf-browser-vm-xrdp-startwm
COPY packaging/browser-vm/mcnf-browser-vm-session.sh /tmp/mcnf-browser-vm-session
COPY packaging/browser-vm/verify-session-input-contract.sh /tmp/mcnf-browser-vm-verify-session-input
COPY packaging/browser-vm/mcnf-browser-vm-media-fixture.html /tmp/mcnf-browser-vm-media-fixture.html
COPY packaging/browser-vm/mcnf-browser-vm-media-probe.sh /tmp/mcnf-browser-vm-media-probe
COPY packaging/browser-vm/mcnf-x11-present-copy.c /tmp/mcnf-x11-present-copy.c
COPY packaging/browser-vm/mcnf-browser-vm-managed-policy.json /tmp/mcnf-browser-vm-managed-policy.json
COPY crates/desktop/mde-media-core/tests/fixtures/tiny_clip.mkv /tmp/mcnf-browser-vm-tiny_clip.mkv
COPY install-helpers/browser-vm-production-control/deploy/browser-vm-guest-audio-probe-controller.service /tmp/browser-vm-guest-audio-probe-controller.service
COPY install-helpers/browser-vm-production-control/deploy/controller-config.example.json /tmp/browser-vm-guest-audio-probe-controller.json
COPY --from=browser-vm-controller-builder /out/browser-vm-guest-audio-probe-controller /tmp/browser-vm-guest-audio-probe-controller
COPY packaging/browser-vm/rpms/ /tmp/mcnf-rpms/
COPY packaging/repo/magic-mesh.repo /etc/yum.repos.d/magic-mesh.repo

RUN set -eux; \
    install -D -m 0755 /tmp/mcnf-browser-vm-validate /usr/local/libexec/mcnf-browser-vm-validate; \
    install -D -m 0755 /tmp/mcnf-browser-vm-runtime /usr/local/libexec/mcnf-browser-vm-runtime; \
    install -D -m 0644 /tmp/mcnf-browser-vm-runtime.service /etc/systemd/system/mcnf-browser-vm-runtime.service; \
    install -D -m 0755 /tmp/mcnf-browser-vm-session /usr/local/libexec/mcnf-browser-vm-session; \
    install -D -m 0755 /tmp/mcnf-browser-vm-verify-session-input /usr/local/libexec/mcnf-browser-vm-verify-session-input; \
    install -D -m 0755 /tmp/mcnf-browser-vm-media-probe /usr/local/libexec/mcnf-browser-vm-media-probe; \
    install -D -m 0644 /tmp/mcnf-browser-vm-media-fixture.html /usr/share/mcnf/browser-vm/mcnf-browser-vm-media-fixture.html; \
    install -D -m 0644 /tmp/mcnf-browser-vm-tiny_clip.mkv /usr/share/mcnf/browser-vm/fixtures/tiny_clip.mkv; \
    useradd --system --home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin mcnf-browser-probe; \
    install -D -m 0755 /tmp/browser-vm-guest-audio-probe-controller /usr/libexec/mcnf/browser-vm-guest-audio-probe-controller; \
    install -D -o mcnf-browser-probe -g mcnf-browser-probe -m 0444 \
        /tmp/browser-vm-guest-audio-probe-controller.json \
        /etc/mcnf/browser-vm-guest-audio-probe-controller.json; \
    install -d -o root -g mcnf-browser-probe -m 0750 /etc/mcnf/browser-vm-control; \
    test ! -e /etc/mcnf/browser-vm-control/controller-secret; \
    install -D -m 0644 /tmp/browser-vm-guest-audio-probe-controller.service \
        /usr/lib/systemd/system/browser-vm-guest-audio-probe-controller.service; \
    install -D -m 0644 /tmp/mcnf-browser-vm-managed-policy.json \
        /etc/chromium/policies/managed/mcnf-browser-vm.json; \
    if [ "${MCNF_RPM_LANE}" = "local" ]; then \
        guest_rpm="$(find /tmp/mcnf-rpms -maxdepth 1 -type f -name 'magic-mesh-lighthouse-*.rpm' -print -quit)"; \
        [ -n "$guest_rpm" ] || { echo 'FATAL: local Browser VM lane needs a magic-mesh-lighthouse RPM'; exit 1; }; \
        [ "$(rpm -qp --qf '%{NAME}' "$guest_rpm")" = magic-mesh-lighthouse ] || { echo 'FATAL: Browser VM accepts only the thin magic-mesh-lighthouse guest package'; exit 1; }; \
        dnf -y --setopt=install_weak_deps=False install "$guest_rpm"; \
    else dnf -y --setopt=install_weak_deps=False --exclude=magic-mesh-browser install magic-mesh-lighthouse; fi; \
    dnf -y --setopt=install_weak_deps=False \
        --exclude=magic-mesh-browser install \
        chromium cloud-init dbus-daemon dbus-tools seatd sway \
        xdg-desktop-portal xdg-desktop-portal-wlr \
        pipewire pipewire-utils pipewire-pulseaudio wireplumber spice-vdagent \
        pipewire-alsa alsa-lib alsa-ucm alsa-utils \
        pulseaudio-utils \
        mesa-dri-drivers mesa-libEGL mesa-libGL mesa-libgbm \
        libva-utils libinput libxkbcommon xorg-x11-server-Xwayland \
        xrdp xrdp-selinux xorgxrdp-glamor qemu-guest-agent \
        gcc libxcb-devel; \
    # wlroots' nested X11 backend presents a child-window pixmap. Keep an
    # unprivileged Sway executable (Fedora's /usr/bin/sway has file capabilities,
    # which intentionally disable LD_PRELOAD) and mirror each presented frame
    # into Xorg's root backing drawable for xorgxrdp's classic capture path.
    cc -shared -fPIC -O2 -Wall -Wextra -Werror \
        -Wl,-z,relro,-z,now,-z,noexecstack \
        -o /usr/local/lib64/libmcnf-x11-present-copy.so \
        /tmp/mcnf-x11-present-copy.c \
        $(pkg-config --cflags --libs xcb xcb-present) -ldl; \
    install -D -m 0755 /usr/bin/sway /usr/local/libexec/mcnf-sway; \
    test -z "$(getcap /usr/local/libexec/mcnf-sway)"; \
    # Fedora's glamor build keeps xrdp's software capture memory synchronized
    # with the composed Xorg screen pixmap.  The Browser VM presents a virtio
    # render node, so admit that DRM driver in addition to Fedora's physical-GPU
    # defaults; otherwise xorgxrdp silently falls back to the stale pfb path.
    sed -i 's/Option "DRMAllowList" "[^"]*"/Option "DRMAllowList" "amdgpu i915 msm radeon virtio_gpu"/' /etc/X11/xrdp/xorg.conf; \
    grep -Fq 'Option "DRMAllowList" "amdgpu i915 msm radeon virtio_gpu"' /etc/X11/xrdp/xorg.conf; \
    # Install the image-owned entrypoint after the xrdp RPM lays down its
    # defaults, then replace Fedora's selected /usr/libexec entrypoint in place.
    # Installing the script under /etc gives it etc_t, which xrdp_session_t is
    # correctly forbidden to execute; the packaged libexec path carries the
    # executable label admitted by Fedora's xrdp SELinux policy.
    install -D -m 0755 /tmp/mcnf-browser-vm-xrdp-startwm /usr/libexec/xrdp/startwm.sh; \
    sed -i 's/^DefaultWindowManager=.*/DefaultWindowManager=startwm.sh/' /etc/xrdp/sesman.ini; \
    grep -Fxq 'DefaultWindowManager=startwm.sh' /etc/xrdp/sesman.ini; \
    # Keep latency-sensitive input on FastPath, but leave graphics on xrdp's
    # slow-path bitmap-update transport. IronRDP 0.10 intentionally advertises
    # no primary drawing orders; xorgxrdp-glamor synchronizes the composed
    # screen before this compatible painter path captures each dirty region.
    sed -i 's/^use_fastpath=.*/use_fastpath=input/' /etc/xrdp/xrdp.ini; \
    grep -Fxq 'use_fastpath=input' /etc/xrdp/xrdp.ini; \
    /usr/local/libexec/mcnf-browser-vm-verify-session-input --image-root /; \
    useradd --create-home --shell /bin/bash mcnf-browser; \
    for group in video input audio seat render; do \
        if ! grep -q "^${group}:" /etc/group; then \
            gid="$(getent group "$group" | awk -F: 'NR == 1 { print $3 }')"; \
            case "$gid" in ''|*[!0-9]*) echo "FATAL: cannot resolve device group $group"; exit 1 ;; esac; \
            grep -q ":${gid}:" /etc/group && { echo "FATAL: device group GID is already allocated: $group=$gid"; exit 1; }; \
            printf '%s:x:%s:\n' "$group" "$gid" >> /etc/group; \
        fi; \
        usermod -a -G "$group" mcnf-browser; \
    done; \
    install -d -o mcnf-browser -g mcnf-browser -m 0700 /var/lib/mcnf-browser; \
    install -d -m 0755 /usr/share/mcnf/browser-vm; \
    printf '%s\n' "$BROWSER_VM_SOURCE_COMMIT" > /usr/share/mcnf/browser-vm/source-commit; \
    printf '%s\n' \
        '{"schema_version":1,"profile":"browser-vm-chromium","browser":"chromium","control_plane":"magic-mesh-lighthouse","compositor":"sway","display":"wayland-over-vdi","gpu":"mesa-virtio","audio":"pipewire","audio_probe_control":"rdp-webaudio-hmac-v1","input":"libinput","transports":["rdp","spice"],"guest_agent":"qemu-guest-agent","network":"mesh-guest","host_browser":false}' \
        > /usr/share/mcnf/browser-vm/image-contract.json; \
    systemctl enable qemu-guest-agent.service; \
    # Fedora ships spice-vdagentd as a static unit. Install the target link
    # explicitly so the guest agent starts when the SPICE channel is present.
    ln -sf /usr/lib/systemd/system/spice-vdagentd.service /etc/systemd/system/multi-user.target.wants/spice-vdagentd.service; \
    systemctl enable xrdp.service; \
    systemctl enable browser-vm-guest-audio-probe-controller.service; \
    dnf -y remove gcc libxcb-devel; \
    rm -rf /tmp/mcnf-rpms /tmp/mcnf-browser-vm-validate /tmp/mcnf-browser-vm-runtime /tmp/mcnf-browser-vm-runtime.service /tmp/mcnf-browser-vm-xrdp-startwm /tmp/mcnf-browser-vm-session /tmp/mcnf-browser-vm-verify-session-input /tmp/mcnf-browser-vm-media-fixture.html /tmp/mcnf-browser-vm-media-probe /tmp/mcnf-browser-vm-tiny_clip.mkv /tmp/mcnf-x11-present-copy.c /tmp/mcnf-browser-vm-managed-policy.json /tmp/browser-vm-guest-audio-probe-controller /tmp/browser-vm-guest-audio-probe-controller.json /tmp/browser-vm-guest-audio-probe-controller.service; \
    dnf clean all

RUN systemctl enable mcnf-browser-vm-runtime.service
RUN systemctl enable seatd.service

# WL-ARCH-008 — Browser VM guest profile contract.
#
# This is the immutable input contract for the future browser-vm image and
# workload adapter. It is intentionally not a host Browser configuration: the
# host owns only the VDI boundary, while Chromium and all page execution live
# in the guest. Keep values unquoted and single-line so provisioning tools can
# consume this file without evaluating shell code.

BROWSER_VM_PROFILE_SCHEMA=1
BROWSER_VM_PROFILE_ID=browser-vm-chromium
BROWSER_VM_IMAGE_ID=browser-vm-chromium
BROWSER_VM_SOURCE_REPOSITORY=https://github.com/matthewmackes/magic-mesh.git
BROWSER_VM_SOURCE_PATH=packaging/browser-vm/profile.env
BROWSER_VM_SOURCE_COMMIT=8d347347d0396b9a7505817fec7976008aa37b68
BROWSER_VM_GUEST_OS=fedora-bootc
BROWSER_VM_COMPOSITOR=sway
BROWSER_VM_BROWSER=chromium
BROWSER_VM_VCPU=4
BROWSER_VM_MEMORY_MB=8192
BROWSER_VM_DISK_GB=64
BROWSER_VM_TRANSPORTS=rdp,spice
BROWSER_VM_DEFAULT_TRANSPORT=rdp
BROWSER_VM_HOST_BROWSER=false
BROWSER_VM_NETWORK=mesh-guest
BROWSER_VM_RUNTIME_FAILURE_POLICY=fail-closed
BROWSER_VM_GUEST_TERMINAL_STATES=failed,unavailable

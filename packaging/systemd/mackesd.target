[Unit]
Description=MCNF grouped control-plane daemon
Documentation=https://github.com/matthewmackes/magic-mesh
Requires=mackesd-control.service mackesd-observation.service mackesd-actions.service mackesd-data.service mackesd-compute.service mackesd-integrations.service
After=network-online.target nebula.service
Wants=network-online.target nebula.service mcnf-cloud-arm-credential.service mcnf-mesh-secret-recipient.service
StopWhenUnneeded=no

[Install]
WantedBy=multi-user.target

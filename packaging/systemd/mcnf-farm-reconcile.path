# FARM-AUTO-4 fill-on-HEAD. TEMPLATE; automation/reconciler/reconciler-up.sh
# rewrites PathModified to $REPO/.git/{logs/HEAD,HEAD}. Keep the 15-min
# timer; this only starts the existing oneshot after a commit so slots do
# not sit empty until OnUnitActiveSec. Never a disposable agent worktree.
[Unit]
Description=MCNF build-farm reconciler — start on HEAD change

[Path]
# PathChanged does not see appends. A same-branch commit only writes
# logs/HEAD (and the branch ref); .git/HEAD stays `ref: refs/heads/…`.
PathModified=/opt/mcnf/.git/logs/HEAD
PathModified=/opt/mcnf/.git/HEAD
Unit=mcnf-farm-reconcile.service

[Install]
WantedBy=paths.target

# BOOT-STATUS-2 — one authoritative status projection for console + Construct.
[Unit]
Description=MCNF informative boot status projection
Documentation=https://github.com/matthewmackes/magic-mesh
After=local-fs.target systemd-journald.service
Before=network-online.target mackesd.target mde-shell-egui.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/usr/libexec/mackesd/mcnf-boot-status
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/mde

[Install]
WantedBy=multi-user.target

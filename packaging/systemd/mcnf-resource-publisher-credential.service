[Unit]
Description=Materialize the host-bound resource publisher credential when available
Documentation=https://github.com/matthewmackes/magic-mesh
# The resource catalog remains inspectable but non-actionable without this key.
# Keep provisioning bounded and outside the shell's boot critical path, but do
# not mask failure: this unit is the operator-visible credential-readiness
# signal and must be failed while the approved mesh secret is unavailable.
Wants=network-online.target
After=network-online.target nebula.service mackesd-control.service
# Retry a temporarily unavailable SecretStore at a paced rate, then leave the
# unit visibly failed instead of spinning forever. Explicit missing/invalid
# credential statuses are terminal and bypass these retries below.
StartLimitIntervalSec=5min
StartLimitBurst=6

[Service]
Type=oneshot
ExecStart=/usr/bin/timeout --signal=TERM --kill-after=5s 30s /usr/libexec/mackesd/provision-resource-publisher-credential
TimeoutStartSec=40s
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
# sysexits: EX_DATAERR (invalid key), EX_NOINPUT (secret absent), and
# EX_CONFIG (broken local installation) require operator action. Other failures
# include boot-time SecretStore/transport unavailability and may be retried.
RestartPreventExitStatus=65 66 78

[Install]
WantedBy=multi-user.target

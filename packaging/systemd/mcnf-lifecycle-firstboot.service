[Unit]
Description=MCNF lifecycle baseline first-boot convergence
After=network-online.target mackesd.target
Wants=network-online.target
ConditionPathExists=/var/lib/mde/role.toml

[Service]
Type=oneshot
ExecStart=/usr/bin/mackesd onboard lifecycle-firstboot
# Do not stamp readiness here. The verb writes firstboot-converged only after
# the canonical baseline has no blocking checks, and writes pending-convergence
# (keeping enrollment tokens) on core failure.

[Install]
WantedBy=multi-user.target

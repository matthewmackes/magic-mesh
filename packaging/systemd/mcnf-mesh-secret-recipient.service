[Unit]
Description=Register this node and reconcile the mesh secret recipient set
Documentation=https://github.com/matthewmackes/magic-mesh
After=network-online.target nebula.service
Wants=network-online.target nebula.service
# This is a best-effort registration lane, not a daemon prerequisite.  The
# timer and mackesd's Wants= edge may start it in parallel; a slow/unavailable
# secret store must not delay the node's control plane or desktop seat.
ConditionPathExists=/var/lib/mde/role.toml

[Service]
Type=oneshot
Environment=MCNF_REPO=/opt/mcnf
ExecStart=/usr/libexec/mackesd/mesh-secret-recipient-reconcile
TimeoutStartSec=45

[Unit]
Description=MCNF peer recovery after resume or network return
Documentation=https://github.com/matthewmackes/magic-mesh
After=network.target
ConditionPathExists=/var/lib/mde/role.toml
OnFailure=mesh-alert@%n.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/libexec/mackesd/mesh-peer-recovery
# A boot or resume event is edge-triggered.  If the bounded recovery helper
# reaches a transient Nebula/substrate failure, no later dispatcher event is
# guaranteed to arrive.  Retry failures within the unit's existing start-limit
# window so the corrected next attempt can converge without an operator or a
# duplicate peer-return event.  Offline/no-mutation exits remain successful and
# therefore do not spin while the machine is intentionally disconnected.
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90
RuntimeMaxSec=90
TimeoutStopSec=10
RuntimeDirectory=mcnf-peer-recovery
RuntimeDirectoryMode=0700
Environment=MCNF_RECOVERY_LOCK=/run/mcnf-peer-recovery/recovery.lock
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Filesystem mutation is delegated to the separately bounded XDG recovery unit,
# which must run in PID 1's mount namespace. Keep this orchestrator blind to
# every home directory.
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Unit]
Description=Materialize the host-bound Music workspace signing credential
Documentation=https://github.com/matthewmackes/magic-mesh
Wants=network-online.target
After=network-online.target
Before=mde-shell-egui.service

[Service]
Type=oneshot
# Best-effort on first boot: the sealed secret may not exist yet. A later
# explicit --refresh converges the same files without restarting the seat.
ExecStart=-/usr/bin/timeout --signal=TERM --kill-after=5s 30s /usr/libexec/mackesd/provision-music-action-credential --refresh
TimeoutStartSec=40s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

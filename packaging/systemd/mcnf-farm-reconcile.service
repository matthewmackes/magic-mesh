# FARM-AUTO-4 — the @farm-build GitOps reconciler, run on the control VM (fleet-
# side, no AI). TEMPLATE; automation/reconciler/reconciler-up.sh installs the live
# copy (EnvironmentFile=/etc/mcnf/reconciler.env, repo slot /opt/mcnf). Never
# mutates infra (no apply gate); dispatches @farm jobs onto the fleet.
[Unit]
Description=MCNF build-farm reconciler (worklist @farm jobs -> fleet builds)
After=network-online.target mcnf-reconciler-bootstrap.service
Wants=network-online.target mcnf-reconciler-bootstrap.service

[Service]
Type=oneshot
Environment=HOME=/root
# Per-mesh config from the rendered env file (no .192/XO literals).
EnvironmentFile=-/etc/mcnf/reconciler.env
WorkingDirectory=/opt/mcnf
# /bin/bash (not EXEC the shebang, not bash -l): some control-host trees are
# not systemd-executable, and a login shell is not required. Never a
# .claude/worktrees path — those get deleted and this unit then dies 200/CHDIR.
ExecStart=/bin/bash /opt/mcnf/automation/reconciler/farm-reconcile.sh
TimeoutStartSec=3600
Nice=10

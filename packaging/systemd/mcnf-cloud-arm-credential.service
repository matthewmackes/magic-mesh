[Unit]
Description=Materialize the host-bound MCNF cloud mutation credential when available
Documentation=https://github.com/matthewmackes/magic-mesh
# This is deliberately best-effort and post-start. A fresh or read-only node
# must bring mackesd up in staged mode immediately; once the sealed mesh secret
# exists, this hook installs the encrypted credential without putting the
# secret store or a service restart on mackesd's boot critical path. The
# credential is consumed on the next explicit controlled restart (`--restart`).
Wants=network-online.target
After=network-online.target mackesd.service

[Service]
Type=oneshot
# The backing secret store may be unavailable while a workstation is booting.
# Keep this best-effort hook bounded so it can never hold mackesd and the shell
# behind an unbounded curl.  The leading dash preserves the staged-mode boot
# path when timeout returns 124. --refresh materializes + daemon-reloads only;
# it never tears down a live seat during boot. --restart remains an explicit
# operator action for applying a newly materialized credential immediately.
ExecStart=-/usr/bin/timeout --signal=TERM --kill-after=5s 30s /usr/libexec/mackesd/provision-cloud-arm-credential --refresh
TimeoutStartSec=40s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

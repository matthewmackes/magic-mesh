[Unit]
Description=Materialize the host-bound MCNF cloud mutation credential when available
Documentation=https://github.com/matthewmackes/magic-mesh
# This is deliberately best-effort. A fresh or read-only node must still bring
# mackesd up in staged mode; once the sealed mesh secret exists, this boot hook
# installs the encrypted credential and its service drop-ins before mackesd
# starts, removing the otherwise permanent manual-restart dependency.
Wants=network-online.target
After=network-online.target
Before=mackesd.service

[Service]
Type=oneshot
# The backing secret store may be unavailable while a workstation is booting.
# Keep this best-effort hook bounded so it can never hold mackesd and the shell
# behind an unbounded curl.  The leading dash preserves the staged-mode boot
# path when timeout returns 124.
ExecStart=-/usr/bin/timeout --signal=TERM --kill-after=5s 30s /usr/libexec/mackesd/provision-cloud-arm-credential
TimeoutStartSec=40s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
